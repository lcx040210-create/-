# X工作者之家 生产环境变量模板
#
# 使用方式：
#   cp deploy/.env.production.example .env.production
#   chmod 600 .env.production
#   # 逐项替换所有 CHANGE_ME / 0x... 占位值后：
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# 注意：本文件会同时被 compose 插值（build args / DOMAIN）和作为容器 env_file 使用，
# 所有启动命令都必须带 `--env-file .env.production`。.env.production 不要提交到 git。

# ===== 数据库（容器网络内） =====
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=xwh
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_DATABASE=xwh

# ===== 域名与前端 =====
# 只填域名，不含 https://；Caddy 用它自动申请证书。
DOMAIN=xwh.example.com
# 浏览器侧 API 地址：同源部署固定 /api（经 Caddy 反代）。
NEXT_PUBLIC_API_URL=/api
# 分享链接 / og:image 用的站点绝对地址（必须与 DOMAIN 的 https 地址一致）。
NEXT_PUBLIC_SITE_URL=https://xwh.example.com
# 容器内 SSR / OG 取数地址（服务端可达，浏览器不可见）。
API_INTERNAL_URL=http://api:4001/api
# 镜像内 CJK 字体路径（frontend 镜像构建时已下载）。
OG_FONT_PATH=/app/fonts/NotoSansSC.ttf

# ===== 后端 =====
PORT=4001
# CORS 允许的前端源，与 NEXT_PUBLIC_SITE_URL 一致。
FRONTEND_URL=https://xwh.example.com

# JWT 双密钥：两个都必须替换为不同的随机串，例如 openssl rand -hex 32。
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET

# 平台 USDT(BEP20) 收款地址（只读，服务器不保存任何私钥）。
PLATFORM_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# 建议使用付费私有 BSC RPC（公共节点限流会影响充值与对账）。
BSC_RPC_URL=https://bsc-dataseed.binance.org
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
DEPOSIT_MIN_CONFIRMATIONS=15

# 首次启动（chain_cursors.last_block=0）时的扫描起点（含该块）。
# 部署前填当前 BSC 区块高度，可避免从区块 1 回扫巨大区间；留空则保持旧行为（从 1 开始，风险自负）。
# 仅在 cursor=0 时生效，之后由监听器自行推进。
BSC_START_BLOCK=

# 对账 deficit 告警 webhook（Telegram Bot API 风格：POST {"text": "..."}）。
# 留空则只写日志。
ALERT_WEBHOOK_URL=

# 管理员账号：ADMIN_ADDRESS 是管理员登录地址，ADMIN_PASSWORD 用于 /admin/login 密码登录。
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
